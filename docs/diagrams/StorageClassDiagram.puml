@startuml
!include style.puml
skinparam classBackgroundColor STORAGE_COLOR
skinparam arrowColor STORAGE_COLOR

package Storage <<Rectangle>> {
interface "Storage" as StorageApi
class StorageManager
class JsonTuiTrackerStorage
class JsonUserPrefsStorage
class JsonSerializableTuiTracker
class JsonAdaptedStudent
class JsonAdaptedLesson
class JsonAdaptedEnrollment
}

StorageManager ..|> StorageApi
StorageManager --> JsonTuiTrackerStorage
StorageManager --> JsonUserPrefsStorage
JsonTuiTrackerStorage ..> JsonSerializableTuiTracker
JsonSerializableTuiTracker *--> "0..*" JsonAdaptedStudent
JsonSerializableTuiTracker *--> "0..*" JsonAdaptedLesson
JsonSerializableTuiTracker *--> "0..*" JsonAdaptedEnrollment
@enduml
