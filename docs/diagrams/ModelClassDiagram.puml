@startuml
!include style.puml
skinparam classBackgroundColor MODEL_COLOR
skinparam arrowColor MODEL_COLOR

package Model <<Rectangle>> {
interface "Model" as ModelApi
interface ReadOnlyTuiTracker
interface ReadOnlyUserPrefs
class ModelManager
class TuiTracker
class UserPrefs
class UniqueStudentList
class UniqueLessonList
class EnrollmentList
class IdGenerator
class Student
class Lesson
class Enrollment
class StudentId
class LessonId
}

ModelManager ..|> ModelApi
TuiTracker ..|> ReadOnlyTuiTracker
UserPrefs ..|> ReadOnlyUserPrefs
ModelManager *--> TuiTracker
ModelManager *--> UserPrefs
TuiTracker *--> UniqueStudentList
TuiTracker *--> UniqueLessonList
TuiTracker *--> EnrollmentList
TuiTracker *--> IdGenerator

UniqueStudentList --> "0..*" Student
UniqueLessonList --> "0..*" Lesson
EnrollmentList --> "0..*" Enrollment
Student --> StudentId
Lesson --> LessonId
Enrollment --> StudentId : studentId
Enrollment --> LessonId : lessonId
@enduml
