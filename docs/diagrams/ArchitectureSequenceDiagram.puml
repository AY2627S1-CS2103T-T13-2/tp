@startuml
!include style.puml
skinparam ArrowFontStyle plain

Actor User as user USER_COLOR
Participant ":MainWindow" as ui UI_COLOR
Participant ":LogicManager" as logic LOGIC_COLOR
Participant ":ModelManager" as model MODEL_COLOR
Participant ":StorageManager" as storage STORAGE_COLOR

user -[USER_COLOR]> ui : "delete student 12"
activate ui UI_COLOR
ui -[UI_COLOR]> logic : execute("delete student 12")
activate logic LOGIC_COLOR
logic -[LOGIC_COLOR]> model : findStudent(StudentId(12))
activate model MODEL_COLOR
model -[MODEL_COLOR]-> logic : student found
logic -[LOGIC_COLOR]> model : deleteStudent(StudentId(12))
model -[MODEL_COLOR]-> logic : student deleted; enrollments removed
deactivate model
logic -[LOGIC_COLOR]> storage : saveTuiTracker(updated data)
activate storage STORAGE_COLOR
storage --[STORAGE_COLOR]-> logic : saved
deactivate storage
logic --[LOGIC_COLOR]-> ui : CommandResult
deactivate logic
ui--[UI_COLOR]> user : confirmation; refresh lists
deactivate ui
@enduml
