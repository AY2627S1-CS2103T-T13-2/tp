@startuml
!include style.puml
skinparam ArrowFontStyle plain

Participant ":LogicManager" as LogicManager LOGIC_COLOR
Participant "d:DeleteCommand" as DeleteCommand LOGIC_COLOR
Participant ":ModelManager" as ModelManager MODEL_COLOR
Participant "t:TuiTracker" as TuiTracker MODEL_COLOR

LogicManager -> DeleteCommand : execute(ModelManager)
activate DeleteCommand LOGIC_COLOR

DeleteCommand -> ModelManager : findStudent(StudentId(12))
ModelManager -> TuiTracker : findStudent(StudentId(12))
TuiTracker --> ModelManager : Optional<Student>
ModelManager --> DeleteCommand : Optional<Student>

alt Student exists
    DeleteCommand -> ModelManager : deleteStudent(StudentId(12))
    ModelManager -> TuiTracker : deleteStudent(StudentId(12))
    TuiTracker --> ModelManager : deleted Student
    ModelManager --> DeleteCommand : deleted Student
    DeleteCommand --> LogicManager : CommandResult with confirmation
else Student does not exist
    DeleteCommand --> LogicManager : CommandException: student not found
end

deactivate DeleteCommand
@enduml
