@startuml
!include style.puml
skinparam ArrowFontStyle plain

Actor User as user USER_COLOR
Participant ":MainWindow" as MainWindow UI_COLOR
Participant ":LogicManager" as LogicManager LOGIC_COLOR
Participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
Participant ":ModelManager" as ModelManager MODEL_COLOR
Participant ":StorageManager" as StorageManager STORAGE_COLOR

user -[USER_COLOR]> MainWindow : executeCommand("delete KIND ID")
activate MainWindow UI_COLOR
MainWindow -[UI_COLOR]> LogicManager : execute("delete KIND ID")
activate LogicManager LOGIC_COLOR

LogicManager -> AddressBookParser : parseCommand("delete KIND ID")
activate AddressBookParser LOGIC_COLOR
AddressBookParser --> LogicManager : d:DeleteCommand
deactivate AddressBookParser

LogicManager -> ModelManager : getTuiTracker()
ModelManager --> LogicManager : current tracker
LogicManager -> LogicManager : copy tracker for rollback
alt KIND is student
    ref over LogicManager, ModelManager : Execute delete student 12\n(see student sequence below)
else KIND is lesson
    ref over LogicManager, ModelManager : Execute delete lesson 7\n(see lesson sequence below)
end

alt Command succeeds
    LogicManager -> ModelManager : getTuiTracker()
    ModelManager --> LogicManager : updated data
    LogicManager -> StorageManager : saveTuiTracker(updated data)
    StorageManager --> LogicManager : saved
    LogicManager --> MainWindow : CommandResult
    MainWindow -> MainWindow : refresh panels and display confirmation
else Command fails
    LogicManager --> MainWindow : CommandException
    MainWindow -> MainWindow : display error
end

deactivate LogicManager
deactivate MainWindow
@enduml
