@startuml
!include style.puml
skinparam ArrowFontStyle plain

Actor User as user USER_COLOR
Participant ":MainWindow" as MainWindow UI_COLOR
Participant ":LogicManager" as LogicManager LOGIC_COLOR
Participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
Participant ":DeleteCommandParser" as DeleteCommandParser LOGIC_COLOR
Participant "d:DeleteCommand" as DeleteCommand LOGIC_COLOR
Participant ":ModelManager" as ModelManager MODEL_COLOR
Participant "t:TuiTracker" as TuiTracker MODEL_COLOR
Participant ":StorageManager" as StorageManager STORAGE_COLOR

user -[USER_COLOR]> MainWindow : executeCommand("delete student 12")
activate MainWindow UI_COLOR
MainWindow -[UI_COLOR]> LogicManager : execute("delete student 12")
activate LogicManager LOGIC_COLOR

LogicManager -> AddressBookParser : parseCommand("delete student 12")
activate AddressBookParser LOGIC_COLOR
create DeleteCommandParser
AddressBookParser -> DeleteCommandParser : create
activate DeleteCommandParser LOGIC_COLOR
AddressBookParser -> DeleteCommandParser : parse(" student 12")
create DeleteCommand
DeleteCommandParser -> DeleteCommand : create(StudentId(12))
activate DeleteCommand LOGIC_COLOR
DeleteCommand --> DeleteCommandParser : d
deactivate DeleteCommand
DeleteCommandParser --> AddressBookParser : d
deactivate DeleteCommandParser
destroy DeleteCommandParser
AddressBookParser --> LogicManager : d
deactivate AddressBookParser

LogicManager -> ModelManager : getTuiTracker()
ModelManager --> LogicManager : current tracker
LogicManager -> LogicManager : copy tracker for rollback
LogicManager -> DeleteCommand : execute(ModelManager)
activate DeleteCommand LOGIC_COLOR

alt KIND is student
    DeleteCommand -> ModelManager : findStudent(StudentId(12))
    ModelManager -> TuiTracker : findStudent(StudentId(12))
    TuiTracker --> ModelManager : Optional<Student>
    ModelManager --> DeleteCommand : Optional<Student>
    alt Student exists
        DeleteCommand -> ModelManager : deleteStudent(StudentId(12))
        ModelManager -> TuiTracker : deleteStudent(StudentId(12))
        note right of TuiTracker
            Deletes the student and all their enrollments.
        end note
        TuiTracker --> ModelManager : deleted Student
        ModelManager --> DeleteCommand : deleted Student
        DeleteCommand --> LogicManager : CommandResult with confirmation
    else Student does not exist
        DeleteCommand --> LogicManager : CommandException: student not found
    end
else KIND is lesson
    DeleteCommand -> ModelManager : findLesson(LessonId(7))
    ModelManager -> TuiTracker : findLesson(LessonId(7))
    TuiTracker --> ModelManager : Optional<Lesson>
    ModelManager --> DeleteCommand : Optional<Lesson>
    alt Lesson exists
        DeleteCommand -> ModelManager : deleteLesson(LessonId(7))
        ModelManager -> TuiTracker : deleteLesson(LessonId(7))
        note right of TuiTracker
            Deletes the lesson and all enrollments tied to it.
        end note
        TuiTracker --> ModelManager : deleted Lesson
        ModelManager --> DeleteCommand : deleted Lesson
        DeleteCommand --> LogicManager : CommandResult with confirmation
    else Lesson does not exist
        DeleteCommand --> LogicManager : CommandException: lesson not found
    end
end
deactivate DeleteCommand

alt Command succeeds
    LogicManager -> ModelManager : getTuiTracker()
    ModelManager --> LogicManager : updated data
    LogicManager -> StorageManager : saveTuiTracker(updated data)
    StorageManager --> LogicManager : saved
    LogicManager --> MainWindow : CommandResult
    MainWindow -> MainWindow : refresh student and lesson panels
    MainWindow -> MainWindow : display confirmation
else Command fails
    LogicManager --> MainWindow : CommandException
    MainWindow -> MainWindow : display error
end

deactivate LogicManager
deactivate MainWindow
@enduml
