@startuml
!include style.puml
skinparam classBackgroundColor UI_COLOR
skinparam arrowColor UI_COLOR_T4

package UI <<Rectangle>> {
interface Ui
class UiManager
class MainWindow
class CommandBox
class ResultDisplay
class StudentListPanel
class LessonListPanel
class SchedulePanel
class StudentCard
class LessonCard
class StatusBarFooter
class HelpWindow
}

UiManager ..|> Ui
UiManager --> MainWindow

MainWindow *--> CommandBox
MainWindow *--> ResultDisplay
MainWindow *--> StudentListPanel
MainWindow *--> LessonListPanel
MainWindow *--> SchedulePanel
MainWindow *--> StatusBarFooter
MainWindow --> HelpWindow

StudentListPanel *--> "0..*" StudentCard
LessonListPanel *--> "0..*" LessonCard
@enduml
