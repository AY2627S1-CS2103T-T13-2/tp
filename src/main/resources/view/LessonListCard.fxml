<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="150" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" minHeight="105" GridPane.columnIndex="0">
      <padding>
        <Insets top="5" right="5" bottom="5" left="15" />
      </padding>
      <Label fx:id="subject" text="\$subject" styleClass="cell_big_label" />
      <Label fx:id="id" styleClass="cell_small_label" text="\$id" />
      <Label fx:id="level" styleClass="cell_small_label" text="\$level" />
      <Label fx:id="timeslot" styleClass="cell_small_label" text="\$timeslot" />
      <Label fx:id="fee" styleClass="cell_small_label" text="\$fee" />
      <Label fx:id="students" styleClass="cell_small_label" text="\$students" />
    </VBox>
  </GridPane>
</HBox>
